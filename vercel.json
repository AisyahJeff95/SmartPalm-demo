{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/demo/PalmnexReaDS",
      "destination": "/demo/PalmnexReaDS.html"
    },
    {
      "source": "/demo/(.*)",
      "destination": "/demo/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "palmnex-demo.com.my"
        }
      ],
      "destination": "/demo/$1"
    },
    {
      "source": "/",
      "destination": "/Reada-standalone/index.html"
    },
    {
      "source": "/PalmnexReaDS",
      "destination": "/Reada-standalone/PalmnexReaDS.html"
    },
    {
      "source": "/palmnexreads",
      "destination": "/Reada-standalone/PalmnexReaDS.html"
    },
    {
      "source": "/reada",
      "destination": "/Reada-standalone/PalmnexReaDS.html"
    },
    {
      "source": "/reada.html",
      "destination": "/Reada-standalone/PalmnexReaDS.html"
    },
    {
      "source": "/comprehensive",
      "destination": "/Reada-standalone/comprehensive.html"
    },
    {
      "source": "/standard",
      "destination": "/Reada-standalone/standard.html"
    },
    {
      "source": "/(css|js|data|pages)/(.*)",
      "destination": "/Reada-standalone/$1/$2"
    },
    {
      "source": "/(.*)",
      "destination": "/Reada-standalone/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}