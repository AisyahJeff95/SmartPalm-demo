{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "demo.palmnex.com.my"
        }
      ],
      "destination": "https://oilpalm.palmnex.com.my/$1",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "palmnex-demo.com.my"
        }
      ],
      "destination": "https://oilpalm.palmnex.com.my/$1",
      "permanent": false
    },
    {
      "source": "/palmnexreads",
      "destination": "/palmnexreads/",
      "permanent": false
    },
    {
      "source": "/PalmnexReaDS",
      "destination": "/palmnexreads/",
      "permanent": false
    },
    {
      "source": "/PalmnexReaDS.html",
      "destination": "/palmnexreads/",
      "permanent": false
    },
    {
      "source": "/reada",
      "destination": "/palmnexreads/",
      "permanent": false
    },
    {
      "source": "/reada.html",
      "destination": "/palmnexreads/",
      "permanent": false
    },
    {
      "source": "/demo/PalmnexReaDS",
      "destination": "/palmnexreads/",
      "permanent": false
    },
    {
      "source": "/demo/PalmnexReaDS.html",
      "destination": "/palmnexreads/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "palmnex.com.my"
        }
      ],
      "destination": "/Reada-standalone/landing.html"
    },
    {
      "source": "/index",
      "has": [
        {
          "type": "host",
          "value": "palmnex.com.my"
        }
      ],
      "destination": "/Reada-standalone/landing.html"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "palmnex.com.my"
        }
      ],
      "destination": "/Reada-standalone/landing.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.palmnex.com.my"
        }
      ],
      "destination": "/Reada-standalone/landing.html"
    },
    {
      "source": "/index",
      "has": [
        {
          "type": "host",
          "value": "www.palmnex.com.my"
        }
      ],
      "destination": "/Reada-standalone/landing.html"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "www.palmnex.com.my"
        }
      ],
      "destination": "/Reada-standalone/landing.html"
    },
    {
      "source": "/landing",
      "destination": "/Reada-standalone/landing.html"
    },
    {
      "source": "/landing.html",
      "destination": "/Reada-standalone/landing.html"
    },
    {
      "source": "/palmnexreads/",
      "destination": "https://smart-palm-demo.vercel.app/"
    },
    {
      "source": "/palmnexreads/(.*)",
      "destination": "https://smart-palm-demo.vercel.app/$1"
    },
    {
      "source": "/demo",
      "destination": "/Reada-standalone/command-center.html"
    },
    {
      "source": "/demo/index",
      "destination": "/Reada-standalone/command-center.html"
    },
    {
      "source": "/demo/index.html",
      "destination": "/Reada-standalone/command-center.html"
    },
    {
      "source": "/demo/(.*)",
      "destination": "/Reada-standalone/$1"
    },
    {
      "source": "/",
      "destination": "/Reada-standalone/command-center.html"
    },
    {
      "source": "/index",
      "destination": "/Reada-standalone/command-center.html"
    },
    {
      "source": "/index.html",
      "destination": "/Reada-standalone/command-center.html"
    },
    {
      "source": "/comprehensive",
      "destination": "/Reada-standalone/comprehensive.html"
    },
    {
      "source": "/standard",
      "destination": "/Reada-standalone/standard.html"
    },
    {
      "source": "/kpsm",
      "destination": "/Reada-standalone/kpsm.html"
    },
    {
      "source": "/(css|js|data|pages)/(.*)",
      "destination": "/Reada-standalone/$1/$2"
    },
    {
      "source": "/(.*)",
      "destination": "/Reada-standalone/$1"
    }
  ],
  "headers": [
    {
      "source": "/((?!.*\\.(?:mp4|webm|jpg|jpeg|png|webp|gif)$).*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)\\.(mp4|webm|jpg|jpeg|png|webp|gif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=86400"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    }
  ]
}
