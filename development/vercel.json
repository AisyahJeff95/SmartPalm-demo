{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/PalmnexReaDS",
      "destination": "https://www.palmnex.com.my",
      "permanent": false
    },
    {
      "source": "/PalmnexReaDS.html",
      "destination": "https://www.palmnex.com.my",
      "permanent": false
    },
    {
      "source": "/palmnexreads",
      "destination": "https://www.palmnex.com.my",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/comprehensive",
      "destination": "/comprehensive.html"
    },
    {
      "source": "/standard",
      "destination": "/standard.html"
    },
    {
      "source": "/reada",
      "destination": "/PalmnexReaDS.html"
    },
    {
      "source": "/reada.html",
      "destination": "/PalmnexReaDS.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}